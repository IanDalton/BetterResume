GEMINI_API_KEY=your_gemini_api_key
OPENROUTER_API_KEY=your_openrouter_api_key

# LLM models (provider-prefixed). These SEED the runtime configuration stored in
# the app_settings table; once the admin dashboard sets a model, the stored value
# wins and these are only used as a last resort (e.g. database unreachable).
DEFAULT_MODEL=openrouter:wafer/fp4
# Optional per-task overrides; each defaults to DEFAULT_MODEL.
# TRANSLATION_MODEL=
# IMPORT_MODEL=
# Fallback models used when the primary fails (two-layer fallback: transport
# errors via FallbackModel, output-retry exhaustion via an explicit re-run).
# Leaving a *_FALLBACK_MODEL unset disables the fallback entirely for that
# task -- primary failures then surface as a hard error instead of degrading
# gracefully. GENERATION_FALLBACK_MODEL is set by default here since
# generation is the highest-traffic, user-facing path; translation/import are
# left off unless you have a specific reason to want them covered too.
GENERATION_FALLBACK_MODEL=google-gla:gemini-2.5-flash-lite
# TRANSLATION_FALLBACK_MODEL=
# IMPORT_FALLBACK_MODEL=
DB_USER=betterresume_user
DB_PASSWORD=betterresume_password
DB_HOST=localhost
DB_NAME=betterresume_db
EMBEDDING_SERVICE_URL=http://embedding-service-br:80/v1
STRIPE_PUBLIC_KEY=your_stripe_public_key

# Admin dashboard
FIREBASE_PROJECT_ID=your_firebase_project_id
ADMIN_EMAIL=daltioan@gmail.com

# Logging (optional)
LOG_LEVEL=INFO
# LOG_FILE=/var/log/betterresume/api.log
